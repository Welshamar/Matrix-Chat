PORT=4000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/matrix_chat?schema=public"
JWT_SECRET="replace-with-a-long-random-value"
CORS_ORIGIN="http://localhost:3200"

# Sends registration/login verification-code emails (see lib/mailer.ts).
# A dedicated transactional email service (Resend, SendGrid, ...) normally
# restricts a fresh account to sending only to its own sign-up address until
# a domain is verified -- a hard blocker with no domain to verify. Two ways
# around that without owning a domain; set whichever is easier to finish
# (Gmail is tried first if both are set):
#
# Option A -- Gmail over SMTP. Gmail carries its own sending reputation, so
# it can mail any address from day one. GMAIL_USER is the sending address;
# GMAIL_APP_PASSWORD is a 16-character App Password generated for it --
# never the account's own login password -- from Google Account > Security
# > 2-Step Verification (must be turned on first) > App Passwords. Some free
# PaaS hosts block outbound raw SMTP to stop spam relay abuse (unconfirmed
# for Render as of writing) -- if so, use Option B instead.
GMAIL_USER="youraddress@gmail.com"
GMAIL_APP_PASSWORD="xxxxxxxxxxxxxxxx"

# Option B -- SendGrid over HTTPS (works even where SMTP is blocked). Only
# needs Single Sender Verification on SENDGRID_FROM_EMAIL -- click the link
# SendGrid emails to it, no domain or DNS records -- then an API key from
# https://app.sendgrid.com/settings/api_keys.
# SENDGRID_API_KEY="SG.xxxxxxxxxxxxxxxxxxxxxxxx"
# SENDGRID_FROM_EMAIL="youraddress@gmail.com"

# Optional. Push notifications (FCM) to the Android app when a message
# arrives with no live socket connection. The whole service account JSON
# as one line, from a Firebase project's Settings > Service Accounts >
# Generate new private key. Left unset, push notifications are silently
# skipped (see lib/push.ts) — everything else works without it.
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
