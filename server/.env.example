PORT=4000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/matrix_chat?schema=public"
JWT_SECRET="replace-with-a-long-random-value"
CORS_ORIGIN="http://localhost:3200"

# Sends registration/login verification-code emails via Gmail SMTP.
# GMAIL_APP_PASSWORD is a 16-character App Password (requires 2-Step
# Verification enabled on the Google account) — not your regular password.
# Generate one at https://myaccount.google.com/apppasswords
GMAIL_USER="you@gmail.com"
GMAIL_APP_PASSWORD="xxxxxxxxxxxxxxxx"
