PORT=4000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/matrix_chat?schema=public"
JWT_SECRET="replace-with-a-long-random-value"
CORS_ORIGIN="http://localhost:3200"

# Sends registration/login verification-code emails via Resend's HTTP API
# (not raw SMTP — some hosts block outbound SMTP ports entirely). Get a key
# at https://resend.com/api-keys. Without a verified domain in Resend, mail
# can only be delivered to the Resend account's own sign-up email address.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Optional. Push notifications (FCM) to the Android app when a message
# arrives with no live socket connection. The whole service account JSON
# as one line, from a Firebase project's Settings > Service Accounts >
# Generate new private key. Left unset, push notifications are silently
# skipped (see lib/push.ts) — everything else works without it.
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
