generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A registered device/user identity. The server only ever stores PUBLIC
// key material for this user — private keys never leave the client.
model User {
  id             String   @id @default(uuid())
  username       String   @unique
  // Optional so existing accounts created before email verification was
  // added aren't broken by this migration — login only enforces
  // emailVerified for accounts that actually have an email on file.
  email          String?  @unique
  emailVerified  Boolean  @default(false)
  // Single active 6-digit code, replaced on every register/resend — no
  // history of past codes is kept, matching the code's 10-minute lifetime.
  verificationCode          String?
  verificationCodeExpiresAt DateTime?
  // Separate from the pair above rather than reused -- an "email verify"
  // code and a "reset my password" code are different capabilities, and
  // keeping them apart means one flow can never accidentally satisfy the
  // other's check. Same single-active-code, 10-minute-lifetime shape.
  passwordResetCode          String?
  passwordResetCodeExpiresAt DateTime?
  passwordHash   String
  registrationId Int?
  avatarUrl      String? // small base64 data: URL, client-resized — no object storage configured
  statusText     String? @default("Hey there! I am using Matrix Chat.")
  // FCM registration token for the Android app, refreshed on every login —
  // used to push a notification when a message arrives while this user has
  // no live socket connection (see signal.gateway.ts). One device at a
  // time; a second device's registration just overwrites this.
  fcmToken       String?
  createdAt      DateTime @default(now())
  // Set when the user's last active socket disconnects (see
  // signal.gateway.ts); null until their first-ever disconnect, which the
  // client reads as "no last-seen on record" rather than a real timestamp.
  lastSeenAt     DateTime?

  identityKey    IdentityKey?
  signedPreKey   SignedPreKey?
  oneTimePreKeys OneTimePreKey[]

  sentMessages     Message[]     @relation("SentMessages")
  receivedMessages Message[]     @relation("ReceivedMessages")
  groupMemberships GroupMember[]
  attachments      Attachment[]
}

// Long-term Curve25519 identity public key (Signal Protocol IdentityKey).
model IdentityKey {
  id        String   @id @default(uuid())
  userId    String   @unique
  publicKey String // base64
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Medium-term signed prekey, rotated periodically by the client and
// verified against the identity key's signature before use.
model SignedPreKey {
  id        String   @id @default(uuid())
  userId    String   @unique
  keyId     Int
  publicKey String // base64
  signature String // base64
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// One-time prekeys consumed exactly once during X3DH session setup, then
// marked used so they are never handed out twice.
model OneTimePreKey {
  id        String   @id @default(uuid())
  userId    String
  keyId     Int
  publicKey String // base64
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, keyId])
  @@index([userId, used])
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

// Zero-knowledge relay row: `ciphertext` is an opaque Double Ratchet
// blob. The server never decrypts it, never derives keys from it, and
// this is the ONLY message content ever persisted.
//
// Group messages are NOT a separate encryption scheme: the Signal
// library here only supports pairwise sessions, so a "group send" is
// really the client fanning out one normal pairwise-encrypted send per
// member. `groupId` just tags each member's individual copy so
// recipients can file it into the right group thread; `recipientId` is
// still the one real recipient of that specific row.
model Message {
  id                String        @id @default(uuid())
  senderId          String
  recipientId       String
  groupId           String?
  ciphertext        String? // base64 Signal ciphertext blob — opaque to the server; nulled out once a view-once message has been viewed
  signalMessageType Int // 3 = PreKeyWhisperMessage, 1 = WhisperMessage
  kind              MessageKind   @default(TEXT)
  viewOnce          Boolean       @default(false)
  viewedAt          DateTime?
  status            MessageStatus @default(SENT)
  timestamp         DateTime      @default(now())

  sender    User   @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User   @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)
  group     Group? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([recipientId, timestamp])
  @@index([senderId, timestamp])
  @@index([groupId, timestamp])
}

enum MessageKind {
  TEXT
  VOICE
  FILE
}

// A group's membership roster. Encryption is still purely pairwise (see
// Message above) — this table only tracks who's in the group and who
// can manage it, so the client knows who to fan a "group send" out to.
model Group {
  id        String   @id @default(uuid())
  name      String
  avatarUrl String?
  createdBy String
  createdAt DateTime @default(now())

  members  GroupMember[]
  messages Message[]
}

enum GroupRole {
  ADMIN
  MEMBER
}

model GroupMember {
  id       String    @id @default(uuid())
  groupId  String
  userId   String
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

// Large files (videos, documents, full-size photos) don't travel through the
// realtime socket: the sender encrypts them client-side in chunks with a random
// key, uploads the ciphertext over plain HTTP, and only a small pointer + key
// goes inside the (Signal-encrypted) chat message. The server therefore only
// ever holds opaque encrypted bytes, and drops them after a retention window
// (see attachments.controller.ts).
model Attachment {
  id          String   @id @default(uuid())
  ownerId     String
  totalChunks Int
  // Declared size while uploading, actual stored bytes once complete.
  size        Int
  complete    Boolean  @default(false)
  createdAt   DateTime @default(now())

  owner  User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  chunks AttachmentChunk[]

  @@index([ownerId])
  @@index([createdAt])
}

model AttachmentChunk {
  attachmentId String
  index        Int
  length       Int
  data         Bytes

  attachment Attachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)

  @@id([attachmentId, index])
}
