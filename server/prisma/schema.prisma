generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A registered device/user identity. The server only ever stores PUBLIC
// key material for this user — private keys never leave the client.
model User {
  id             String   @id @default(uuid())
  username       String   @unique
  passwordHash   String
  registrationId Int?
  avatarUrl      String? // small base64 data: URL, client-resized — no object storage configured
  statusText     String? @default("Hey there! I am using Matrix Chat.")
  createdAt      DateTime @default(now())

  identityKey    IdentityKey?
  signedPreKey   SignedPreKey?
  oneTimePreKeys OneTimePreKey[]

  sentMessages     Message[]     @relation("SentMessages")
  receivedMessages Message[]     @relation("ReceivedMessages")
  groupMemberships GroupMember[]
}

// Long-term Curve25519 identity public key (Signal Protocol IdentityKey).
model IdentityKey {
  id        String   @id @default(uuid())
  userId    String   @unique
  publicKey String // base64
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Medium-term signed prekey, rotated periodically by the client and
// verified against the identity key's signature before use.
model SignedPreKey {
  id        String   @id @default(uuid())
  userId    String   @unique
  keyId     Int
  publicKey String // base64
  signature String // base64
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// One-time prekeys consumed exactly once during X3DH session setup, then
// marked used so they are never handed out twice.
model OneTimePreKey {
  id        String   @id @default(uuid())
  userId    String
  keyId     Int
  publicKey String // base64
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, keyId])
  @@index([userId, used])
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

// Zero-knowledge relay row: `ciphertext` is an opaque Double Ratchet
// blob. The server never decrypts it, never derives keys from it, and
// this is the ONLY message content ever persisted.
//
// Group messages are NOT a separate encryption scheme: the Signal
// library here only supports pairwise sessions, so a "group send" is
// really the client fanning out one normal pairwise-encrypted send per
// member. `groupId` just tags each member's individual copy so
// recipients can file it into the right group thread; `recipientId` is
// still the one real recipient of that specific row.
model Message {
  id                String        @id @default(uuid())
  senderId          String
  recipientId       String
  groupId           String?
  ciphertext        String? // base64 Signal ciphertext blob — opaque to the server; nulled out once a view-once message has been viewed
  signalMessageType Int // 3 = PreKeyWhisperMessage, 1 = WhisperMessage
  kind              MessageKind   @default(TEXT)
  viewOnce          Boolean       @default(false)
  viewedAt          DateTime?
  status            MessageStatus @default(SENT)
  timestamp         DateTime      @default(now())

  sender    User   @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User   @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)
  group     Group? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([recipientId, timestamp])
  @@index([senderId, timestamp])
  @@index([groupId, timestamp])
}

enum MessageKind {
  TEXT
  VOICE
}

// A group's membership roster. Encryption is still purely pairwise (see
// Message above) — this table only tracks who's in the group and who
// can manage it, so the client knows who to fan a "group send" out to.
model Group {
  id        String   @id @default(uuid())
  name      String
  avatarUrl String?
  createdBy String
  createdAt DateTime @default(now())

  members  GroupMember[]
  messages Message[]
}

enum GroupRole {
  ADMIN
  MEMBER
}

model GroupMember {
  id       String    @id @default(uuid())
  groupId  String
  userId   String
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}
