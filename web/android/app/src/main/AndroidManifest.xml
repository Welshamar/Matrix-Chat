<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Keeps the process alive and unthrottled while a call is active
             and the app is backgrounded — see CallForegroundService. -->
        <service
            android:name=".CallForegroundService"
            android:foregroundServiceType="microphone|camera"
            android:exported="false" />

        <!-- Bridges native screen capture into the WebView call — see
             ScreenCaptureService. Android requires the mediaProjection
             type to be declared here before a MediaProjection can be used. -->
        <service
            android:name=".ScreenCaptureService"
            android:foregroundServiceType="mediaProjection"
            android:exported="false" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Voice calls: the WebView's getUserMedia() request is only ever
         granted if the app both declares this and grants it at runtime in
         MainActivity's WebChromeClient — see onPermissionRequest there. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Video calls: same story as RECORD_AUDIO: getUserMedia({ video }) is
         only granted if the app declares CAMERA. Not required, so the app
         still installs on devices without a camera (voice calls still work). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />
    <!-- Chat notifications (Android 13+ requires this to be requested at
         runtime in addition to being declared here). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Keeps a call alive while the app is backgrounded — see
         CallForegroundService. Android 14+ requires the specific FGS type
         permissions in addition to the general one. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <!-- Native screen sharing (see ScreenCaptureService) — Android's own
         screen-capture consent dialog is requested at runtime via
         MediaProjectionManager; this just permits the foreground service
         that Android requires while a projection is active. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
</manifest>
